# Server Configuration
PORT=5000
NODE_ENV=development

# Portfolio Owner Email (Where contact messages are delivered)
OWNER_EMAIL=kummambharath@gmail.com
PORTFOLIO_URL=http://localhost:8080

# Secure Email Configuration (Gmail / Resend / Custom SMTP)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kummambharath@gmail.com
SMTP_PASS=your_gmail_app_password_here

# Database File Path
DATABASE_PATH=./messages.db
